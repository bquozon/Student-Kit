# Copy to .env for local dev. On the VPS the installer keeps these in /etc/student-kit.env (mode 600).
# Public address, no trailing slash. https:// turns on Secure cookies and HSTS.
SITE_URL=http://localhost:8800
# Gets moderator rights at seed time. Must be a university email (that's the only way to log in).
ADMIN_EMAIL=you@student.ethz.ch
# Outgoing mail (login links, approve/reject, mod digest). Leave SMTP_HOST empty in dev: mails go to data/outbox.txt.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Swiss Student Kit <noreply@example.ch>
# Where kit.sqlite, backups/ and outbox.txt live (the container uses /data).
DATA_DIR=data
