# Copy to .env for local dev. On the VPS the installer keeps these in /etc/student-kit.env (mode 600).
# Public address, no trailing slash. https:// turns on Secure cookies and HSTS.
SITE_URL=http://localhost:8800
# The mod password: log in at SITE_URL/mod. Long and random; the installer makes one.
ADMIN_KEY=change-me-to-something-long-and-random
# Optional: a daily email when suggestions or link reports are waiting. Needs SMTP below (e.g. kMail: mail.infomaniak.com, 465).
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Swiss Student Kit <noreply@example.ch>
# Where kit.sqlite, backups/ and outbox.txt live (the container uses /data).
DATA_DIR=data
